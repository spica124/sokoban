; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/app_id="ca-app-pub-2437962101962485~2658675622"
general/ios/enabled=false

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Sokoban"
config/version="0.1.0"
run/main_scene="res://scenes/MainMenu.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.png"

[autoload]

Global="*res://scripts/Global.gd"
Levels="*res://scripts/Levels.gd"
Assets="*res://scripts/Assets.gd"
Transition="*res://scripts/Transition.gd"
Achievements="*res://scripts/Achievements.gd"
Ads="*res://scripts/Ads.gd"
DevTools="*res://scripts/DevTools.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[gui]

theme/custom_font_fallbacks=PackedStringArray()

[rendering]

textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.094, 0.11, 0.153, 1)
