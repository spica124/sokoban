# Godot editor cache (rebuilt on import)
.godot/
# Android Gradle build template (reinstalled by --install-android-build-template)
/android/

# Exported builds (Sokoban.exe alone is over GitHub's 100 MB limit)
/build/

# Asset delivery archives; their contents are already unpacked into assets/
/*.zip

# Regenerated by tools/verify_ui_alignment.gd on every run
/docs/screenshots/

# Python
__pycache__/
*.pyc
